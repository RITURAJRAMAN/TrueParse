{
  "$defs": {
    "JobError": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "JobProgress": {
      "properties": {
        "stage": {
          "default": "queued",
          "title": "Stage",
          "type": "string"
        },
        "current_page": {
          "default": 0,
          "minimum": 0,
          "title": "Current Page",
          "type": "integer"
        },
        "total_pages": {
          "default": 0,
          "minimum": 0,
          "title": "Total Pages",
          "type": "integer"
        }
      },
      "title": "JobProgress",
      "type": "object"
    },
    "JobStatus": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "batch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        },
        "input_index": {
          "minimum": 0,
          "title": "Input Index",
          "type": "integer"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled",
            "expired"
          ],
          "title": "State",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "attempt": {
          "default": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "max_attempts": {
          "title": "Max Attempts",
          "type": "integer"
        },
        "progress": {
          "$ref": "#/$defs/JobProgress"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status_url": {
          "title": "Status Url",
          "type": "string"
        },
        "result_url": {
          "title": "Result Url",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "input_index",
        "filename",
        "state",
        "created_at",
        "max_attempts",
        "status_url",
        "result_url"
      ],
      "title": "JobStatus",
      "type": "object"
    }
  },
  "properties": {
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "mixed",
        "expired"
      ],
      "title": "State",
      "type": "string"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/JobStatus"
      },
      "title": "Jobs",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "status_url": {
      "title": "Status Url",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "state",
    "total",
    "counts",
    "jobs",
    "status_url"
  ],
  "title": "BatchStatus",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trueparse:schema:1.0:batch"
}
